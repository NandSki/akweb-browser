{
    "browser_specific_settings": {
        "gecko": {
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "id": "akv2-solver@example.invalid",
            "strict_min_version": "157.0"
        }
    },
    "background": {
        "persistent": true,
        "scripts": [
            "bridge.js"
        ]
    },
    "content_scripts": [
        {
            "all_frames": true,
            "js": [
                "solver.js"
            ],
            "match_about_blank": false,
            "matches": [
                "https://prod-web-pool.miniclip.com/*",
                "https://*.pool.miniclippt.com/*",
                "https://*.miniclip.com/*",
                "https://*.miniclippt.com/*",
                "https://8ballpool.com/*",
                "https://www.8ballpool.com/*"
            ],
            "run_at": "document_start"
        }
    ],
    "description": "Injects the 8BP heap solver (Tampermonkey userscript, v2.64) into the game frames. PoC-3: background bridge.js (native messaging JSON ke Kotlin, tanpa .so). Separate from the AKWeb extension.",
    "manifest_version": 2,
    "name": "8BP Heap Solver v2.64",
    "permissions": [
        "nativeMessaging",
        "nativeMessagingFromContent",
        "geckoViewAddons",
        "storage",
        "https://prod-web-pool.miniclip.com/*",
        "https://*.pool.miniclippt.com/*",
        "https://*.miniclip.com/*",
        "https://*.miniclippt.com/*",
        "https://8ballpool.com/*",
        "https://www.8ballpool.com/*"
    ],
    "version": "2.46"
}
